# MONGO_SOURCE choisit quelle URI utiliser au démarrage : "local" ou "atlas".
MONGO_SOURCE=local

# URI de votre MongoDB local (utilisée si MONGO_SOURCE=local)
MONGODB_URI_LOCAL=mongodb://localhost:27017/guitar-practice-cloud

# URI de votre cluster MongoDB Atlas (utilisée si MONGO_SOURCE=atlas)
MONGODB_URI_ATLAS=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/guitar-practice-cloud?retryWrites=true&w=majority

# Legacy : si MONGO_SOURCE/les variables ci-dessus sont absentes, MONGODB_URI seule suffit toujours.
# MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/guitar-practice-cloud?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-local-secret
PORT=3000
